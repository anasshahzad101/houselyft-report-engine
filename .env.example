# Runtime secrets — never committed. Provided per-session or via routine configuration.
GHL_TOKEN=pit-xxxxxxxx
GHL_LOCATION=xxxxxxxx

# Aerial imagery fallback (engine/aerial_imagery.py).
# Mapbox is the paid universal fallback; it stays inert unless MAPBOX_TOKEN is set.
MAPBOX_TOKEN=pk.xxxxxxxx
# Optional hard monthly reservation cap for Mapbox (default 10000).
MAPBOX_MONTHLY_CAP=10000
# Apps Script dropbox that persists the Mapbox monthly counter across cloud runs.
# Same deployment/key ghl/client.py uses. Names must be exactly DROPBOX_URL / DROPBOX_KEY -
# if unset, the budget check fails closed and Mapbox is skipped even with a valid token.
DROPBOX_URL=https://script.google.com/macros/s/xxxxxxxx/exec
DROPBOX_KEY=xxxxxxxx
